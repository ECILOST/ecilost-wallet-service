# Plantilla de configuracion local. Copiala a .env, que no se versiona.
#   cp .env.example .env

PORT=3002

# Base propia del servicio: un esquema por servicio, sin joins cruzados.
# El puerto es 5435 y no 5434 porque ese ya lo ocupa la base de ecilost-catalog-service.
DATABASE_URL="postgresql://wallet:wallet@localhost:5435/ecilost_wallet?schema=wallet"

# De donde se baja la llave publica para verificar el access token. El servicio la verifica
# en local contra esta JWKS y no llama a auth-service en cada peticion.
AUTH_JWKS_URL="http://localhost:3000/.well-known/jwks.json"

# Tienen que coincidir EXACTAMENTE con JWT_ISSUER y JWT_AUDIENCE de ecilost-auth-service.
# Si no coinciden, todas las rutas responden 401 con un token que en realidad es valido.
AUTH_ISSUER="https://auth.ecilost.local"
AUTH_AUDIENCE="ecilost-services"

# Saldo con el que nace una billetera, en ECICoin (1 ECICoin = 1 peso colombiano). Entero no negativo.
INITIAL_ECICOIN_BALANCE=10000

# Broker de eventos para el aprovisionamiento idempotente de usuarios nuevos.
RABBITMQ_URL=amqp://ecilost:ecilost@localhost:5672
